<% content_for :title, "Edit profile" %>
<div
  class="mx-auto max-w-xl rounded-2xl border border-slate-200 bg-white p-8 shadow-sm"
>
  <h1 class="text-xl font-semibold tracking-tight">Edit profile</h1>
  <%= form_with(
    model: @user,
    url: profile_path,
    method: :patch,
    class: "mt-6 space-y-4",
    data: { controller: "avatar-preview" }
  ) do |form| %>
    <% if @user.errors.any? %>
      <div
        class="rounded-lg border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-800"
      >
        <ul class="list-inside list-disc">
          <% @user.errors.full_messages.each { |message| %>
          <li><%= message %></li>
          <% } %>
        </ul>
      </div>
    <% end %>
    <div>
      <%= form.label :full_name, class: "block text-sm font-medium" %>
      <%= form.text_field(
        :full_name,
        class: "mt-1 w-full rounded-lg border border-slate-300 px-3 py-2
        text-sm"
      ) %>
    </div>
    <div>
      <%= form.label :email_address, class: "block text-sm font-medium" %>
      <%= form.email_field(
        :email_address,
        class: "mt-1 w-full rounded-lg border border-slate-300 px-3
        py-2 text-sm"
      ) %>
    </div>
    <div>
      <%= form.label(
        :password,
        "New password (leave blank to keep current)",
        class: "block text-sm
        font-medium"
      ) %>
      <%= form.password_field(
        :password,
        autocomplete: "new-password",
        class: "mt-1 w-full rounded-lg border border-slate-300 px-3 py-2 text-sm"
      ) %>
    </div>
    <div>
      <%= form.label(
        :password_confirmation,
        class: "block text-sm font-medium"
      ) %>
      <%= form.password_field(
        :password_confirmation,
        autocomplete: "new-password",
        class: "mt-1 w-full rounded-lg border border-slate-300 px-3 py-2 text-sm"
      ) %>
    </div>
    <div>
      <%= form.label :avatar_image, class: "block text-sm font-medium" %>
      <div class="mt-1 flex items-center gap-3">
        <% if @user.avatar_image.attached? %>
          <%= image_tag(
            @user.avatar_image,
            data: { avatar_preview_target: "image" },
            class: "h-14 w-14 rounded-full object-cover ring-1 ring-slate-200"
          ) %>
        <% else %>
          <img
            data-avatar-preview-target="image"
            class="hidden h-14 w-14 rounded-full object-cover ring-1 ring-slate-200"
          >
        <% end %>
        <%= form.file_field(
          :avatar_image,
          accept: "image/png,image/jpeg,image/webp,image/gif",
          data: {
            avatar_preview_target: "input",
            action: "change->avatar-preview#preview"
          },
          class: "text-sm"
        ) %>
      </div>
    </div>
    <div class="flex gap-3">
      <%= form.submit(
        "Save changes",
        class: "rounded-lg bg-slate-900 px-4 py-2 text-sm font-medium text-white hover:bgslate-800"
      ) %>
      <%= link_to(
        "Cancel",
        profile_path,
        class: "rounded-lg border border-slate-300 px-4 py-2 text-sm font-medium hover:bg-slate-50"
      ) %>
    </div>
  <% end %>
</div>
