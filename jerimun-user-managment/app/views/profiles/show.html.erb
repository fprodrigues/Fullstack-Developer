<% content_for :title, "Profile" %>
<div class="mx-auto max-w-2xl">
  <div class="rounded-2xl border border-slate-200 bg-white p-8 shadow-sm">
    <div class="flex items-center gap-4">
      <% if @user.avatar_image.attached? %>
        <%= image_tag(
          @user.avatar_image,
          class: "h-16 w-16 rounded-full object-cover ring-1 ringslate-200"
        ) %>
      <% else %>
        <div
          class="flex h-16 w-16 items-center justify-center rounded-full bg-slate-200 text-lg fontsemibold text-slate-600"
        >
          <%= @user.initials %>
        </div>
      <% end %>
      <div>
        <h1 class="text-xl font-semibold tracking-tight"><%= @user.full_name %></h1>
        <p class="text-sm text-slate-600"><%= @user.email_address %></p>
        <span
          class="mt-1 inline-block rounded-full bg-slate-100 px-2 py-0.5 text-xs font-medium
uppercase tracking-wide text-slate-600"
        >
          <%= @user.role %>
        </span>
      </div>
    </div>
    <dl class="mt-8 grid grid-cols-1 gap-4 text-sm sm:grid-cols-2">
      <div>
        <dt class="text-slate-500">Member since</dt>
        <dd class="font-medium"><%= l(
          @user.created_at.to_date,
          format: :long
        ) %></dd>
      </div>
      <div>
        <dt class="text-slate-500">Last updated</dt>
        <dd class="font-medium"><%= l(
          @user.updated_at.to_date,
          format: :long
        ) %></dd>
      </div>
    </dl>
    <div class="mt-8 flex flex-wrap gap-3">
      <%= link_to(
        "Edit profile",
        edit_profile_path,
        class: "rounded-lg bg-slate-900 px-4 py-2 text-sm font-medium text-white hover:bgslate-800"
      ) %>
      <%= button_to "Delete my account", profile_path, method: :delete,
form: { data: { turbo_confirm: "This permanently deletes your account. Continue?" } },
class: "rounded-lg border border-red-300 px-4 py-2 text-sm font-medium text-red-700
hover:bg-red-50" %>
    </div>
  </div>
</div>
