<% content_for :title, "Welcome" %>
<div
  class="mx-auto max-w-md rounded-2xl border border-slate-200 bg-white p-8 text-center shadow-sm"
>
  <h1 class="text-2xl font-semibold tracking-tight">User Management</h1>
  <p class="mt-2 text-sm text-slate-600">Sign in or create an account to continue.</p>
  <div class="mt-6 flex flex-col gap-3">
    <%= link_to(
      "Sign in",
      new_session_path,
      class: "rounded-lg bg-slate-900 px-4 py-2.5 text-sm font-medium text-white hover:bgslate-800"
    ) %>
    <%= link_to(
      "Create an account",
      new_registration_path,
      class: "rounded-lg border border-slate-300 px-4 py-2.5 text-sm font-medium hover:bg-slate-50"
    ) %>
  </div>
</div>
