<% content_for :title, "Sign in" %>
<div
  class="mx-auto max-w-md rounded-2xl border border-slate-200 bg-white p-8 shadow-sm"
>
  <%= image_tag(
    "jerimum.jpeg",
    width: 200,
    height: 100,
    style: "display: block; margin: 0 auto;"
  ) %>
  <h1 class="text-xl font-semibold tracking-tight"> Jerimun - Sign in</h1>
  <%= form_with url: session_path, class: "mt-6 space-y-4" do |form| %>
    <div>
      <%= form.label :email_address, class: "block text-sm font-medium" %>
      <%= form.email_field(
        :email_address,
        required: true,
        autofocus: true,
        autocomplete: "username",
        value: params[:email_address],
        class: "mt-1 w-full rounded-lg border border-slate-300 px-3 py-2 text-sm"
      ) %>
    </div>
    <div>
      <%= form.label :password, class: "block text-sm font-medium" %>
      <%= form.password_field(
        :password,
        required: true,
        autocomplete: "current-password",
        class: "mt-1 w-full rounded-lg border border-slate-300 px-3 py-2 text-sm"
      ) %>
    </div>
    <%= form.submit(
      "Sign in",
      class: "w-full rounded-lg bg-slate-900 px-4 py-2.5 text-sm font-medium text-white hover:bgslate-800"
    ) %>
  <% end %>
  <div class="mt-4 flex justify-between text-sm">
    <%= link_to(
      "Forgot password?",
      new_password_path,
      class: "text-slate-600 hover:text-slate-900"
    ) %>
    <%= link_to(
      "Create an account",
      new_registration_path,
      class: "text-slate-600 hover:textslate-900"
    ) %>
  </div>
</div>
