<% content_for :title, "Users" %>
<div class="flex items-center justify-between">
  <h1 class="text-2xl font-semibold tracking-tight">Users</h1>
  <%= link_to(
    "New user",
    new_admin_user_path,
    class: "rounded-lg bg-slate-900 px-4 py-2 text-sm font-medium text-white hover:bg-slate-800"
  ) %>
</div>
<div
  class="mt-6 overflow-x-auto rounded-2xl border border-slate-200 bg-white shadow-sm"
>
  <table class="min-w-full divide-y divide-slate-200 text-sm">
    <thead
      class="bg-slate-50 text-left text-xs uppercase tracking-wide text-slate-500"
    >
      <tr>
        <th class="px-6 py-3 font-medium">Name</th>
        <th class="px-6 py-3 font-medium">Email</th>
        <th class="px-6 py-3 font-medium">Role</th>
        <th class="px-6 py-3 font-medium">Created</th>
        <th class="px-6 py-3 text-right font-medium">Actions</th>
      </tr>
    </thead>
    <tbody class="divide-y divide-slate-100">
      <% @users.each do |user| %>
        <tr id="<%= dom_id(user) %>">
          <td class="px-6 py-3">
            <div class="flex items-center gap-3">
              <% if user.avatar_image.attached? %>
                <%= image_tag(
                  user.avatar_image,
                  class: "h-8 w-8 rounded-full object-cover"
                ) %>
              <% else %>
                <div
                  class="flex h-8 w-8 items-center justify-center rounded-full bg-slate-200 text-xs
font-semibold text-slate-600"
                >
                  <%= user.initials %>
                </div>
              <% end %>
              <span class="font-medium"><%= user.full_name %></span>
            </div>
          </td>
          <td class="px-6 py-3 text-slate-600"><%= user.email_address %></td>
          <td class="px-6 py-3">
            <span
              class="rounded-full px-2 py-0.5 text-xs font-medium uppercase tracking-wide
<%= user.admin? ? "bg-indigo-100 text-indigo-700" : "bg-slate-100 textslate-600" %>"
            >
              <%= user.role %>
            </span>
          </td>
          <td class="px-6 py-3 text-slate-500"><%= l user.created_at.to_date %></td>
          <td class="px-6 py-3">
            <div class="flex justify-end gap-2">
              <%= link_to(
                "Edit",
                edit_admin_user_path(user),
                class: "rounded-lg border border-slate-300 px-3 py-1.5 text-xs font-medium hover:bgslate-50"
              ) %>
              <% unless user == current_user %>
                <%= button_to "Make #{user.admin? ? "user" : "admin"}",
toggle_role_admin_user_path(user), method: :patch,
class: "rounded-lg border border-slate-300 px-3 py-1.5 text-xs font-medium
hover:bg-slate-50" %>
                <%= button_to(
                  "Delete",
                  admin_user_path(user),
                  method: :delete,
                  form: { data: { turbo_confirm: "Delete #{user.full_name}?" } },
                  class: "rounded-lg border border-red-300 px-3 py-1.5 text-xs font-medium textred-700 hover:bg-red-50"
                ) %>
              <% end %>
            </div>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>
