<% content_for :title, @user.full_name %>
<div
  class="mx-auto max-w-xl rounded-2xl border border-slate-200 bg-white p-8 shadow-sm"
>
  <h1 class="text-xl font-semibold tracking-tight"><%= @user.full_name %></h1>
  <p class="mt-1 text-sm text-slate-600"><%= @user.email_address %> &middot; <%= @user.role %></p>
  <div class="mt-6 flex gap-3">
    <%= link_to "Edit", edit_admin_user_path(@user),
class: "rounded-lg bg-slate-900 px-4 py-2 text-sm font-medium text-white hover:bg-slate-800" %
>
<%= link_to "Back", admin_users_path,
class: "rounded-lg border border-slate-300 px-4 py-2 text-sm font-medium hover:bg-slate-50" %>
  </div>
</div>
