<% content_for :title, "Dashboard" %>
<%= turbo_stream_from "admin_dashboard" %>
<div class="flex items-center justify-between">
  <h1 class="text-2xl font-semibold tracking-tight">Dashboard</h1>
  <%= link_to(
    "Import users",
    new_admin_user_import_path,
    class: "rounded-lg bg-slate-900 px-4 py-2 text-sm font-medium text-white hover:bg-slate-800"
  ) %>
</div>
<div id="dashboard_stats" class="mt-6">
  <%= render "admin/dashboard/stats", stats: @stats %>
</div>
<div class="mt-10 rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
  <h2 class="text-sm font-semibold uppercase tracking-wide text-slate-500">Recent imports</h2>
  <% if @recent_imports.any? %>
    <ul class="mt-4 divide-y divide-slate-100 text-sm">
      <% @recent_imports.each do |import| %>
        <li class="flex items-center justify-between py-3">
          <%= link_to(
            import.filename,
            admin_user_import_path(import),
            class: "font-medium
            hover:underline"
          ) %>
          <span class="text-slate-500"><%= import.status %> &middot; <%= import.successful_rows %>
            created</span>
        </li>
      <% end %>
    </ul>
  <% else %>
    <p class="mt-4 text-sm text-slate-500">No imports yet.</p>
  <% end %>
</div>
