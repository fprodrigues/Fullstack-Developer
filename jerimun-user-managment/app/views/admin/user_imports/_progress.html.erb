<div
  id="user_import_progress"
  class="rounded-2xl border border-slate-200 bg-white p-8 shadow-sm"
>
  <div class="flex items-start justify-between gap-4">
    <div>
      <h1 class="text-lg font-semibold tracking-tight"><%= user_import.filename %></h1>
      <p class="mt-1 text-sm text-slate-500">
        status: <span class="font-medium text-slate-700"><%= user_import.status %></span>
      </p>
    </div>
    <span class="text-3xl font-semibold tabular-nums"><%= user_import.progress_percent %>%</span>
  </div>
  <div class="mt-6 h-2.5 w-full overflow-hidden rounded-full bg-slate-100">
    <div
      class="h-full rounded-full transition-all duration-300
<%= user_import.failed? ? "bg-red-500" : "bg-slate-900" %>"
      style="width: <%= user_import.progress_percent %>%"
    ></div>
  </div>
  <p class="mt-3 text-sm tabular-nums text-slate-600">
    <%= user_import.processed_rows %> / <%= user_import.total_rows %> rows
  </p>
  <dl class="mt-6 grid grid-cols-2 gap-4 text-sm">
    <div class="rounded-xl bg-emerald-50 px-4 py-3">
      <dt class="text-emerald-700">created</dt>
      <dd class="text-xl font-semibold tabular-nums text-emerald-800"><%= user_import.successful_rows %></dd>
    </div>
    <div class="rounded-xl bg-red-50 px-4 py-3">
      <dt class="text-red-700">failed</dt>
      <dd class="text-xl font-semibold tabular-nums text-red-800"><%= user_import.failed_rows %></dd>
    </div>
  </dl>
  <% if user_import.error_message.present? %>
    <p
      class="mt-6 rounded-lg border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-800"
    >
      <%= user_import.error_message %>
    </p>
  <% end %>
</div>
