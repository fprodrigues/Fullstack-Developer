<% content_for :title, "Imports" %>
<div class="flex items-center justify-between">
  <h1 class="text-2xl font-semibold tracking-tight">User imports</h1>
  <%= link_to(
    "New import",
    new_admin_user_import_path,
    class: "rounded-lg bg-slate-900 px-4 py-2 text-sm font-medium text-white hover:bg-slate-800"
  ) %>
</div>
<div
  class="mt-6 overflow-x-auto rounded-2xl border border-slate-200 bg-white shadow-sm"
>
  <table class="min-w-full divide-y divide-slate-200 text-sm">
    <thead
      class="bg-slate-50 text-left text-xs uppercase tracking-wide text-slate-500"
    >
      <tr>
        <th class="px-6 py-3 font-medium">File</th>
        <th class="px-6 py-3 font-medium">Status</th>
        <th class="px-6 py-3 font-medium">Rows</th>
        <th class="px-6 py-3 font-medium">Created by</th>
        <th class="px-6 py-3 font-medium">When</th>
      </tr>
    </thead>
    <tbody class="divide-y divide-slate-100">
      <% @user_imports.each do |user_import| %>
        <tr>
          <td class="px-6 py-3">
            <%= link_to(
              user_import.filename,
              admin_user_import_path(user_import),
              class: "font-medium hover:underline"
            ) %>
          </td>
          <td class="px-6 py-3"><%= user_import.status %></td>
          <td class="px-6 py-3 tabular-nums">
            <%= user_import.successful_rows %> ok / <%= user_import.failed_rows %> failed
          </td>
          <td class="px-6 py-3 text-slate-600"><%= user_import.created_by.full_name %></td>
          <td class="px-6 py-3 text-slate-500"><%= l(
            user_import.created_at,
            format: :short
          ) %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>
