<% content_for :title, "New import" %>
<div
  class="mx-auto max-w-xl rounded-2xl border border-slate-200 bg-white p-8 shadow-sm"
>
  <h1 class="text-xl font-semibold tracking-tight">Import users</h1>
  <p class="mt-2 text-sm text-slate-600">
    Upload a <code class="rounded bg-slate-100 px-1">.csv</code> or
    <code class="rounded bg-slate-100 px-1">.xlsx</code> file with the columns
    <code class="rounded bg-slate-100 px-1">full_name</code>,
    <code class="rounded bg-slate-100 px-1">email_address</code>,
    <code class="rounded bg-slate-100 px-1">password</code> and
    <code class="rounded bg-slate-100 px-1">role</code>.
  </p>
  <%= form_with(
    model: [:admin, @user_import],
    class: "mt-6 space-y-4"
  ) do |form| %>
    <% if @user_import.errors.any? %>
      <div
        class="rounded-lg border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-800"
      >
        <ul class="list-inside list-disc">
          <% @user_import.errors.full_messages.each do |message| %>
            <li><%= message %></li>
          <% end %>
        </ul>
      </div>
    <% end %>
    <%= form.file_field(
      :file,
      accept: ".csv,.xlsx",
      required: true,
      class: "text-sm"
    ) %>
    <%= form.submit(
      "Start import",
      class: "rounded-lg bg-slate-900 px-4 py-2 text-sm font-medium text-white hover:bg-slate-800"
    ) %>
  <% end %>
</div>
